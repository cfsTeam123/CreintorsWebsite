
{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cautomate.com"
        }
      ],
      "destination": "https://cautomate.com/automation",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.cautomate.com"
        }
      ],
      "destination": "https://cautomate.com/automation",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
